# SECTION 2 — FIXED CO → PO/PSO MATRIX
# ============================================================

def map_co_matrix():
    return [
        ["1","3","-","1","1","3","2","2","2","-","1","1","-","1"],
        ["3","2","2","1","3","2","1","1","1","-","1","3","2","2"],
        ["2","3","2","3","2","2","-","1","1","1","2","2","2","1"],
        ["-","1","1","-","1","3","3","3","3","1","2","1","1"],
        ["1","2","1","1","2","1","1","2","3","2","3","1","1","1"],
    ]


# ============================================================
# DYNAMIC COMPONENT → SDG MAPPING
# ============================================================

def map_sdg_components(components, text):
    """
    Map the AI-generated project components to the fixed SDG list,
    using only evidence from the uploaded CSP book.
    """

    component_names = [
        c["name"] if isinstance(c, dict) else str(c)
        for c in components
    ]

    if not component_names:
        return []

    sdg_text = "\n".join(
        f"SDG {number}: {description}"
        for number, description in SDGS.items()
    )

    system_prompt = """
You are an evidence-grounded SDG mapping analyst.

Use ONLY the supplied CSP project-book text and the supplied
project components.

The SDG catalogue is fixed to SDGs 1 through 17 exactly as supplied.
Do not create new SDGs.

For each project component:
- identify only SDGs that have a meaningful, direct connection
  supported by the project book;
- assign mapping strength 1, 2, or 3:
  3 = high/direct contribution,
  2 = moderate contribution,
  1 = limited but defensible contribution;
- do not assign an SDG just to fill columns;
- do not infer a connection that the document does not support.

Across the complete project, identify the relevant SDGs. Aim for
at least 3 only when the document genuinely supports at least 3.
If the project supports fewer, return fewer.

Return JSON only:
{
  "mappings": [
    {
      "component": "exact component name from the supplied list",
      "sdgs": [
        {
          "number": 1,
          "strength": 1,
          "reason": "brief evidence-based reason"
        }
      ]
    }
  ]
}
"""

    user_prompt = f"""
FIXED SDG CATALOGUE:
{sdg_text}

PROJECT COMPONENTS:
{json.dumps(component_names, ensure_ascii=False, indent=2)}

UPLOADED CSP PROJECT BOOK:
{text}
"""

    result = call_ai_json(system_prompt, user_prompt)

    rows = []
    valid_components = set(component_names)

    for item in result.get("mappings", []):
        if not isinstance(item, dict):
            continue

        component = clean_text(str(item.get("component", "")))

        if component not in valid_components:
            continue

        vals = {}

        for mapping in item.get("sdgs", []):
            if not isinstance(mapping, dict):
                continue

            try:
                number = int(mapping.get("number"))
                strength = int(mapping.get("strength"))
            except (TypeError, ValueError):
                continue

            if number in SDGS and strength in {1, 2, 3}:
                vals[number] = str(strength)

        if vals:
            rows.append((component, vals))

    # Preserve the user's component order. Missing AI rows are not
    # fabricated; they simply have no SDG mapping.
    row_by_name = {name: vals for name, vals in rows}
    ordered_rows = [
        (name, row_by_name[name])
        for name in component_names
        if name in row_by_name
    ]

    return ordered_rows


# ============================================================
# SDG TABLE VALIDATION
# ============================================================

def get_valid_sdg_rows(sdg_rows):
    """
    Use the union of SDGs actually mapped by the AI.
    Missing component/SDG relationships remain '-'.
    No fallback SDGs are invented.
    """

    if not sdg_rows:
        return [], []

    matched_sdgs = sorted({
        sdg
        for _, vals in sdg_rows
        for sdg in vals
        if sdg in SDGS
    })

    valid_rows = []

    for component, vals in sdg_rows:
        valid_rows.append(
            (
                component,
                {
                    sdg: vals[sdg]
                    for sdg in matched_sdgs
                    if sdg in vals
                },
            )
        )

    return valid_rows, matched_sdgs


# ============================================================
# EVIDENCE HELPERS
# ============================================================

def component_evidence_text(analysis):
    lines = []

    for component in analysis.get("components", []):
        name = component.get("name", "")
        lines.append(f"**{name}**")

        for ev in component.get("evidence", []):
            page = ev.get("page")
            quote = ev.get("quote", "")

            if page:
                lines.append(f"- Page {page}: \"{quote}\"")
            else:
                lines.append(f"- \"{quote}\"")

    return "\n".join(lines)

# ============================================================
# REPORTLAB PARAGRAPH HELPER
# ============================================================

def P(
    txt,
    style,
):

    return Paragraph(
        str(txt),
        style
    )


# ============================================================
# BUILD FINAL PDF
#
# NO BORDER
# NO PAGE NUMBER
# NO DEPARTMENT FOOTER
# ============================================================

def build_pdf(
    project_title,
    co_matrix,
    components,
    sdg_rows,
):

    buf = io.BytesIO()


    doc = SimpleDocTemplate(
        buf,
        pagesize=A4,
        rightMargin=12 * mm,
        leftMargin=12 * mm,
        topMargin=12 * mm,
        bottomMargin=12 * mm,
    )


    styles = getSampleStyleSheet()


    title = ParagraphStyle(
        "title",
        parent=styles["Title"],
        alignment=TA_CENTER,
        fontSize=15,
        leading=18,
        spaceAfter=8,
    )


    h = ParagraphStyle(
        "h",
        parent=styles["Heading2"],
        fontSize=12,
        leading=15,
        spaceBefore=6,
        spaceAfter=6,
    )


    body = ParagraphStyle(
        "body",
        parent=styles["BodyText"],
        fontSize=8.5,
        leading=11,
    )


    small = ParagraphStyle(
        "small",
        parent=body,
        fontSize=7,
        leading=9,
    )


    story = []


    # ========================================================
    # TITLE
    # ========================================================

    story.append(
        P(
            "CO-PO-PSO & WK-PO-PSO Mapping",
            title
        )
    )


    story.append(
        Spacer(
            1,
            4
        )
    )


    # ========================================================
    # SECTION 1
    # ========================================================

    story.append(
        P(
            "1) Course Outcomes:",
            h
        )
    )


    story.append(
        P(
            "On successful completion of the Community Service Project, the student will be able to:",
            body
        )
    )


    data = [
        [
            P("CO No.", small),
            P("Course Outcome", small),
            P("Bloom's Level", small),
        ]
    ]


    for co, desc, bloom in COS:

        data.append(
            [
                P(co, small),
                P(desc, small),
                P(bloom, small),
            ]
        )


    tbl = Table(
        data,
        colWidths=[
            18 * mm,
            126 * mm,
            35 * mm,
        ],
        repeatRows=1,
    )


    tbl.setStyle(
        TableStyle(
            [
                (
                    "GRID",
                    (0, 0),
                    (-1, -1),
                    0.6,
                    colors.black,
                ),
                (
                    "BACKGROUND",
                    (0, 0),
                    (-1, 0),
                    colors.whitesmoke,
                ),
                (
                    "VALIGN",
                    (0, 0),
                    (-1, -1),
                    "MIDDLE",
                ),
                (
                    "ALIGN",
                    (0, 0),
                    (-1, 0),
                    "CENTER",
                ),
                (
                    "FONTNAME",
                    (0, 0),
                    (-1, 0),
                    "Helvetica-Bold",
                ),
                (
                    "LEFTPADDING",
                    (0, 0),
                    (-1, -1),
                    4,
                ),
                (
                    "RIGHTPADDING",
                    (0, 0),
                    (-1, -1),
                    4,
                ),
                (
                    "TOPPADDING",
                    (0, 0),
                    (-1, -1),
                    4,
                ),
                (
                    "BOTTOMPADDING",
                    (0, 0),
                    (-1, -1),
                    4,
                ),
            ]
        )
    )


    story.append(tbl)


    story.append(
        Spacer(
            1,
            8
        )
    )


    # ========================================================
    # SECTION 2
    # ========================================================

    story.append(
        P(
            "2) COs Vs POs and PSOs:",
            h
        )
    )


    data = [
        [P("CO", small)]
        + [
            P(x, small)
            for x in HEADERS
        ]
    ]


    for (co, _, _), row in zip(
        COS,
        co_matrix,
    ):

        data.append(
            [P(co, small)]
            + [
                P(x, small)
                for x in row
            ]
        )


    tbl = Table(
        data,
        colWidths=[
            14 * mm
        ]
        + [
            12.2 * mm
        ] * 14,
        repeatRows=1,
    )


    tbl.setStyle(
        TableStyle(
            [
                (
                    "GRID",
                    (0, 0),
                    (-1, -1),
                    0.5,
                    colors.black,
                ),
                (
                    "BACKGROUND",
                    (0, 0),
                    (-1, 0),
                    colors.whitesmoke,
                ),
                (
                    "ALIGN",
                    (0, 0),
                    (-1, -1),
                    "CENTER",
                ),
                (
                    "VALIGN",
                    (0, 0),
                    (-1, -1),
                    "MIDDLE",
                ),
                (
                    "FONTNAME",
                    (0, 0),
                    (-1, 0),
                    "Helvetica-Bold",
                ),
                (
                    "FONTSIZE",
                    (0, 0),
                    (-1, -1),
                    6,
                ),
            ]
        )
    )


    story.append(tbl)


    story.append(
        Spacer(
            1,
            5
        )
    )


    story.append(
        P(
            "Scale: 3 = High    2 = Medium    1 = Low    - = No mapping",
            small
        )
    )


    story.append(
        PageBreak()
    )


    # ========================================================
    # SECTION 3
    # ========================================================

    story.append(
        P(
            "3) Knowledge and Attitude Profile Vs Program Outcomes and Program Specific Outcomes",
            h
        )
    )


    data = [
        [P("", small)]
        + [
            P(x, small)
            for x in HEADERS
        ]
    ]


    for (wk, _), row in zip(
        WKS,
        FIXED_WK_MATRIX,
    ):

        data.append(
            [P(wk, small)]
            + [
                P(x, small)
                for x in row
            ]
        )


    tbl = Table(
        data,
        colWidths=[
            15 * mm
        ]
        + [
            12.1 * mm
        ] * 14,
        repeatRows=1,
    )


    tbl.setStyle(
        TableStyle(
            [
                (
                    "GRID",
                    (0, 0),
                    (-1, -1),
                    0.5,
                    colors.black,
                ),
                (
                    "BACKGROUND",
                    (0, 0),
                    (-1, 0),
                    colors.whitesmoke,
                ),
                (
                    "ALIGN",
                    (0, 0),
                    (-1, -1),
                    "CENTER",
                ),
                (
                    "VALIGN",
                    (0, 0),
                    (-1, -1),
                    "MIDDLE",
                ),
                (
                    "FONTNAME",
                    (0, 0),
                    (-1, 0),
                    "Helvetica-Bold",
                ),
                (
                    "FONTSIZE",
                    (0, 0),
                    (-1, -1),
                    6,
                ),
            ]
        )
    )


    story.append(tbl)


    story.append(
        Spacer(
            1,
            5
        )
    )


    story.append(
        P(
            "Scale: 3 = High    2 = Medium    1 = Low",
            small
        )
    )


    story.append(
        PageBreak()
    )


    # ========================================================
    # SECTION 4
    # ========================================================

    story.append(
        P(
            "4) SDGs Vs Community Service Project Components:",
            h
        )
    )


    story.append(
        Spacer(
            1,
            5
        )
    )


    valid_sdg_rows, matched_sdgs = get_valid_sdg_rows(
        sdg_rows
    )


    if valid_sdg_rows and matched_sdgs:

        data = [
            [
                P(
                    "Project Component",
                    small
                )
            ]
            + [
                P(
                    f"SDG {n}",
                    small
                )
                for n in matched_sdgs
            ]
        ]


        for component, vals in valid_sdg_rows:

            row = [
                P(
                    component,
                    small
                )
            ]


            for n in matched_sdgs:

                row.append(
                    P(
                        vals.get(
                            n,
                            "1"
                        ),
                        small
                    )
                )


            data.append(
                row
            )


        component_width = 68 * mm


        available_width = (
            A4[0] - 24 * mm
        )


        remaining_width = (
            available_width
            - component_width
        )


        sdg_width = (
            remaining_width
            / len(matched_sdgs)
        )


        tbl = Table(
            data,
            colWidths=[
                component_width
            ]
            + [
                sdg_width
            ] * len(matched_sdgs),
            repeatRows=1,
        )


        tbl.setStyle(
            TableStyle(
                [
                    (
                        "GRID",
                        (0, 0),
                        (-1, -1),
                        0.5,
                        colors.black,
                    ),
                    (
                        "BACKGROUND",
                        (0, 0),
                        (-1, 0),
                        colors.whitesmoke,
                    ),
                    (
                        "FONTNAME",
                        (0, 0),
                        (-1, 0),
                        "Helvetica-Bold",
                    ),
                    (
                        "ALIGN",
                        (0, 0),
                        (-1, -1),
                        "CENTER",
                    ),
                    (
                        "ALIGN",
                        (0, 1),
                        (0, -1),
                        "LEFT",
                    ),
                    (
                        "VALIGN",
                        (0, 0),
                        (-1, -1),
                        "MIDDLE",
                    ),
                    (
                        "FONTSIZE",
                        (0, 0),
                        (-1, -1),
                        7,
                    ),
                    (
                        "LEFTPADDING",
                        (0, 0),
                        (-1, -1),
                        4,
                    ),
                    (
                        "RIGHTPADDING",
                        (0, 0),
                        (-1, -1),
                        4,
                    ),
                    (
                        "TOPPADDING",
                        (0, 0),
                        (-1, -1),
                        4,
                    ),
                    (
                        "BOTTOMPADDING",
                        (0, 0),
                        (-1, -1),
                        4,
                    ),
                ]
            )
        )


        story.append(tbl)


        story.append(
            Spacer(
                1,
                6
            )
        )


        story.append(
            P(
                "Mapping scale: 3 = High    2 = Medium    1 = Low",
                small
            )
        )


    else:

        story.append(
            P(
                "No relevant project components were detected for SDG mapping.",
                body
            )
        )


    # ========================================================
    # BUILD PDF
    # ========================================================

    doc.build(
        story
    )


    buf.seek(0)

    return buf.getvalue()




# ============================================================
# STREAMLIT UI
# ============================================================

st.title("📘 CSP Outcome Mapping Generator")

st.caption(
    "Upload one Community Service Project book → "
    "AI extracts project components from the book itself → "
    "generate Sections 1–4 as a PDF."
)


uploaded = st.file_uploader(
    "Upload your CSP Project Book (PDF)",
    type=["pdf"],
)


if uploaded:

    text = extract_text(uploaded)

    if not text.strip():
        st.error(
            "No selectable text was found. "
            "This version needs a text-readable PDF."
        )
        st.stop()

    cleaned = clean_text(text)

    # --------------------------------------------------------
    # AI analysis of the uploaded book.
    # --------------------------------------------------------

    try:
        with st.spinner(
            "Reading the CSP project book and identifying its actual project components..."
        ):
            analysis = analyze_project_book(text)

    except Exception as e:
        st.error(f"Project-book AI analysis failed: {e}")
        st.info(
            "Paste your Gemini API key into .streamlit\\gemini_api_key.txt "
            "or configure GEMINI_API_KEY in Streamlit secrets."
        )
        st.stop()

    project_title = (
        analysis.get("project_title")
        or extract_title(text)
    )

    component_objects = analysis.get("components", [])
    components = [
        item["name"]
        for item in component_objects
        if item.get("name")
    ]

    if not components:
        st.error(
            "The uploaded project book did not contain enough "
            "evidence to identify a substantive project component."
        )
        st.stop()

    # --------------------------------------------------------
    # Fixed Section 2.
    # --------------------------------------------------------

    co_matrix = map_co_matrix()

    # --------------------------------------------------------
    # Initial dynamic Section 4 mapping.
    # --------------------------------------------------------

    try:
        with st.spinner("Mapping the detected components to relevant SDGs..."):
            sdg_rows = map_sdg_components(
                component_objects,
                cleaned,
            )
    except Exception as e:
        st.error(f"SDG mapping failed: {e}")
        st.stop()

    st.success(
        f"Project book extracted successfully. "
        f"Detected {len(text):,} characters and "
        f"{len(components)} project components from the book."
    )

    # --------------------------------------------------------
    # Extracted information + evidence.
    # --------------------------------------------------------

    with st.expander(
        "🔎 AI-extracted project information and evidence",
        expanded=True,
    ):
        st.write(f"**Project title:** {project_title}")

        st.write(
            f"**Components found from the uploaded CSP book ({len(components)}):**"
        )

        for component in components:
            st.write(f"- {component}")

        st.markdown("**Evidence used for component detection:**")

        for component in component_objects:
            st.markdown(f"**{component['name']}**")

            for ev in component.get("evidence", []):
                page = ev.get("page")
                quote = ev.get("quote", "")

                if page:
                    st.write(f'Page {page}: "{quote}"')
                else:
                    st.write(f'"{quote}"')

        st.text_area(
            "Extracted text preview",
            text[:8000],
            height=250,
        )

    # --------------------------------------------------------
    # Optional manual component editing.
    #
    # Editing does NOT use a predefined component list.
    # User can change names, then explicitly re-map SDGs.
    # --------------------------------------------------------

    st.subheader("Project components used for Section 4")

    edited = st.text_area(
        "Edit only if needed. One component per line.",
        "\n".join(components),
        height=180,
    )

    edited_components = [
        x.strip()
        for x in edited.splitlines()
        if x.strip()
    ]

    if st.button(
        "🔄 Re-map SDGs for edited components",
        type="secondary",
    ):
        if not edited_components:
            st.warning("Enter at least one project component.")
        else:
            try:
                edited_objects = [
                    {"name": name, "evidence": []}
                    for name in edited_components
                ]

                with st.spinner(
                    "Checking the edited components against the uploaded CSP book..."
                ):
                    sdg_rows = map_sdg_components(
                        edited_objects,
                        cleaned,
                    )

                st.session_state["sdg_rows"] = sdg_rows
                st.session_state["active_components"] = edited_components
                st.success("SDG mapping updated from the uploaded book.")

            except Exception as e:
                st.error(f"SDG remapping failed: {e}")

    # Use the edited list for the current report after the user
    # explicitly remaps it. Otherwise keep the AI-detected list.
    if "active_components" in st.session_state:
        active_components = st.session_state["active_components"]
        sdg_rows = st.session_state.get("sdg_rows", sdg_rows)
    else:
        active_components = components

    # --------------------------------------------------------
    # Section 2 preview.
    # --------------------------------------------------------

    st.subheader("Section 2 — CO → PO/PSO mapping")

    section2_data = {"CO": [co[0] for co in COS]}

    for i, header in enumerate(HEADERS):
        section2_data[header] = [
            co_matrix[row][i]
            for row in range(5)
        ]

    st.dataframe(
        pd.DataFrame(section2_data),
        use_container_width=True,
        hide_index=True,
    )

    # --------------------------------------------------------
    # Section 3 preview.
    # --------------------------------------------------------

    st.subheader(
        "Section 3 — WK → PO/PSO mapping (fixed)"
    )

    section3_data = {"WK": [wk[0] for wk in WKS]}

    for i, header in enumerate(HEADERS):
        section3_data[header] = [
            FIXED_WK_MATRIX[row][i]
            for row in range(len(WKS))
        ]

    st.dataframe(
        pd.DataFrame(section3_data),
        use_container_width=True,
        hide_index=True,
    )

    # --------------------------------------------------------
    # Section 4 preview.
    # --------------------------------------------------------

    st.subheader("Section 4 — Project Components → SDGs")

    valid_sdg_rows, preview_sdgs = get_valid_sdg_rows(sdg_rows)

    if valid_sdg_rows and preview_sdgs:

        preview_rows = []

        for component, vals in valid_sdg_rows:
            row = {"Project Component": component}

            for n in preview_sdgs:
                row[f"SDG {n}"] = vals.get(n, "-")

            preview_rows.append(row)

        df_preview = pd.DataFrame(
            preview_rows,
            columns=["Project Component"]
            + [f"SDG {n}" for n in preview_sdgs],
        )

        st.dataframe(
            df_preview,
            use_container_width=True,
            hide_index=True,
        )

        st.caption(
            "SDGs shown here are selected from the fixed SDG 1–17 list "
            "only when the uploaded CSP book supports the relationship. "
            "No fallback SDGs or predefined project components are used."
        )

    else:
        st.warning(
            "No defensible SDG relationship was found from the uploaded book."
        )

    # --------------------------------------------------------
    # Generate PDF.
    # --------------------------------------------------------

    if st.button(
        "📄 Generate Final CSP PDF",
        type="primary",
    ):
        try:
            pdf = build_pdf(
                project_title,
                co_matrix,
                active_components,
                sdg_rows,
            )

            st.success(
                "Final CSP PDF generated successfully."
            )

            st.download_button(
                label="⬇️ Download Final PDF",
                data=pdf,
                file_name="CSP_CO_PO_PSO_WK_SDG_Mapping.pdf",
                mime="application/pdf",
                key="download_final_csp_pdf",
            )

        except Exception as e:
            st.error(f"PDF generation failed: {e}")

else:
    st.info(
        "Start by uploading your CSP project book PDF."
    )
