# ============================================================
# EXTRACT PDF TEXT WITH PAGE MARKERS
# ============================================================

def extract_text(uploaded):
    """Extract the complete CSP book and preserve page numbers for AI evidence."""
    reader = PdfReader(uploaded)
    pages = []

    for page_no, page in enumerate(reader.pages, start=1):
        try:
            page_text = page.extract_text() or ""
        except Exception:
            page_text = ""

        pages.append(f"\n[PAGE {page_no}]\n{page_text}")

    return "\n".join(pages)


# ============================================================
# CLEAN TEXT
# ============================================================

def clean_text(text):
    text = text or ""
    text = text.replace("\xa0", " ")
    text = text.replace("&nbsp;", " ")
    text = text.replace("&amp;", "&")
    text = re.sub(r"\s+", " ", text)
    return text.strip()


# ============================================================
# PROJECT TITLE
# ============================================================

def extract_title(text):
    patterns = [
        r"(?:project title|title of the project)\s*[:\-]\s*(.{5,180})",
        r"(?:project)\s*[:\-]\s*(.{5,180})",
    ]

    for pattern in patterns:
        match = re.search(pattern, text, re.IGNORECASE)
        if match:
            title = clean_text(match.group(1))
            return title[:180]

    return "Community Service Project"


# ============================================================
# GEMINI CONFIG
# ============================================================

def get_gemini_settings():
    """Load Gemini settings for local use and Streamlit deployment.

    Local priority: environment variable -> simple key file -> Streamlit secrets.
    The simple key file avoids TOML formatting mistakes on Windows.
    """
    api_key = os.getenv("GEMINI_API_KEY", "").strip()
    model = os.getenv("GEMINI_MODEL", "").strip()

    key_file = Path(".streamlit") / "gemini_api_key.txt"
    if not api_key and key_file.exists():
        api_key = key_file.read_text(encoding="utf-8").strip()

    # Streamlit Community Cloud can supply secrets through st.secrets.
    # Catch TOML errors so a bad local secrets.toml never crashes the app.
    if not api_key:
        try:
            api_key = str(st.secrets.get("GEMINI_API_KEY", "")).strip()
            if not model:
                model = str(st.secrets.get("GEMINI_MODEL", "")).strip()
        except Exception:
            pass

    if not model:
        model = "gemini-3.6-flash"

    if not api_key or api_key == "YOUR_GEMINI_API_KEY_HERE":
        raise RuntimeError(
            "Gemini API key not found. Paste your key into "
            ".streamlit\\gemini_api_key.txt."
        )

    return api_key, model


def call_ai_json(system_prompt, user_prompt):
    api_key, model = get_gemini_settings()
    client = genai.Client(api_key=api_key)

    response = client.models.generate_content(
        model=model,
        contents=f"{system_prompt}\n\n{user_prompt}",
        config={
            "temperature": 0,
            "response_mime_type": "application/json",
        },
    )

    content = getattr(response, "text", None)
    if not content:
        raise RuntimeError("Gemini returned an empty response.")

    try:
        return json.loads(content)
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"Gemini returned invalid JSON: {exc}") from exc


# ============================================================
# DYNAMIC PROJECT COMPONENT DETECTION
#
# IMPORTANT:
# There is NO predefined project-component list here.
# The component names are generated from the uploaded CSP book.
# ============================================================

def analyze_project_book(text):
    """
    Analyze the uploaded CSP book itself and extract substantive
    project components. Nothing domain-specific is hard-coded.
    """

    system_prompt = """
You are an evidence-grounded document analyst.

Your task is to identify the actual project components of a
Community Service Project from the supplied project-book text.

STRICT RULES:
1. Use ONLY information contained in the supplied document.
2. Do NOT assume the project's domain before reading the document.
3. Do NOT use a predefined component taxonomy or a list of
   components from previous projects.
4. Generate the component names yourself from the document.
5. A component must represent a distinct substantive project
   activity, intervention, technical task, community-facing
   activity, implementation activity, training/awareness activity,
   maintenance activity, or problem/solution area actually
   addressed by the project.
6. Ignore acknowledgements, certificates, generic formatting,
   references, and generic statements about teamwork unless they
   describe an actual project activity.
7. Prefer concise, specific noun-phrase labels.
8. Do not invent details merely to reach a target number.
9. Aim for 3 to 5 components when the document genuinely supports
   that many. If it supports fewer, return fewer.
10. Every component MUST have evidence from the document.
11. Page numbers must be taken from [PAGE N] markers in the supplied
    text. Do not guess page numbers.

Return JSON only in this structure:
{
  "project_title": "string",
  "components": [
    {
      "name": "string",
      "evidence": [
        {"page": 1, "quote": "short supporting quote"}
      ]
    }
  ]
}
"""

    # Keep the entire document available to the model. For unusually
    # large books, analyze chunks first so late pages are not silently lost.
    max_chars = 60000

    if len(text) <= max_chars:
        result = call_ai_json(
            system_prompt,
            "Analyze this complete uploaded CSP project book:\n\n" + text
        )
    else:
        chunk_size = 30000
        chunks = [
            text[i:i + chunk_size]
            for i in range(0, len(text), chunk_size)
        ]

        chunk_results = []

        for idx, chunk in enumerate(chunks, start=1):
            chunk_prompt = f"""
Analyze only this part of the uploaded CSP project book.
Extract candidate project components supported by this part.
Do not invent components. Include short evidence and page numbers.

Return JSON:
{{
  "candidates": [
    {{
      "name": "string",
      "evidence": [
        {{"page": 1, "quote": "short supporting quote"}}
      ]
    }}
  ]
}}

This is document chunk {idx} of {len(chunks)}.

DOCUMENT:
{chunk}
"""
            chunk_results.append(
                call_ai_json(system_prompt, chunk_prompt)
            )

        synthesis_prompt = """
Synthesize the actual project components of the uploaded CSP book
from the candidate evidence below.

Rules:
- Use only the supplied candidate evidence.
- Do not introduce a predefined component list.
- Merge duplicate/overlapping candidates.
- Generate concise project-specific component names.
- Aim for 3 to 5 components only when the evidence supports them.
- If fewer are genuinely supported, return fewer.
- Preserve supporting page numbers and short evidence quotes.

Return JSON:
{
  "project_title": "string",
  "components": [
    {
      "name": "string",
      "evidence": [
        {"page": 1, "quote": "short supporting quote"}
      ]
    }
  ]
}

CANDIDATE EVIDENCE:
""" + json.dumps(chunk_results, ensure_ascii=False)

        result = call_ai_json(system_prompt, synthesis_prompt)

    # Defensive normalization: never create components here.
    components = []

    for item in result.get("components", []):
        if not isinstance(item, dict):
            continue

        name = clean_text(str(item.get("name", "")))
        if not name:
            continue

        evidence = []
        for ev in item.get("evidence", []):
            if not isinstance(ev, dict):
                continue

            quote = clean_text(str(ev.get("quote", "")))
            page = ev.get("page")

            try:
                page = int(page)
            except (TypeError, ValueError):
                page = None

            if quote:
                evidence.append({
                    "page": page,
                    "quote": quote[:500],
                })

        if evidence:
            components.append({
                "name": name[:160],
                "evidence": evidence[:5],
            })

    # De-duplicate generated names without replacing them with
    # predefined labels.
    unique = []
    seen = set()

    for component in components:
        key = component["name"].casefold()
        if key not in seen:
            seen.add(key)
            unique.append(component)

    return {
        "project_title": clean_text(
            str(result.get("project_title", ""))
        )[:180] or "Community Service Project",
        "components": unique[:5],
    }


